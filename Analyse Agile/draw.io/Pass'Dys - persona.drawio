" height="110" as="geometry"/></mxCell><mxCell id="c39" value="Bio" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontColor=#3E3A63;fontSize=16;fontFamily=Lexend;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DLexend%3Awght%40400%3B600;fontFamily=Inter Tight;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DInter%2BTight%3Awght%40700;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="372" y="520" width="200" height="24" as="geometry"/></mxCell><mxCell id="c40" value="En 2e année de licence. Au lycée, elle avait un PPS. À la fac, elle doit tout redemander au service handicap." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontColor=#3E3A63;fontSize=15;fontFamily=Lexend;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DLexend%3Awght%40400%3B600;" vertex="1" parent="1"><mxGeometry x="372" y="548" width="836" height="44" as="geometry"/></mxCell><mxCell id="c41" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="372.0" y="608" width="20" height="20" as="geometry"/></mxCell><mxCell id="c42" value="Objectifs" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontColor=#3E3A63;fontSize=16;fontFamily=Lexend;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DLexend%3Awght%40400%3B600;fontFamily=Inter Tight;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DInter%2BTight%3Awght%40700;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="400.0" y="606" width="232.0" height="24" as="geometry"/></mxCell><mxCell id="c43" value="&lt;div style=&quot;margin-bottom:6px&quot;&gt;&amp;#8226;&amp;nbsp; Ses aménagements d'examens&lt;/div&gt;&lt;div style=&quot;margin-bottom:6px&quot;&gt;&amp;#8226;&amp;nbsp; Comprendre le service handicap&lt;/div&gt;&lt;div style=&quot;margin-bottom:6px&quot;&gt;&amp;#822