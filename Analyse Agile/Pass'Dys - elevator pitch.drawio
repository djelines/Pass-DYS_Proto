<mxfile host="drawio" agent="Pass'Dys"><diagram id="pitch" name="Elevator pitch"><mxGraphModel dx="1300" dy="800" grid="0" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1224" pageHeight="974" background="#F8F6F1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="" style="rounded=1;absoluteArcSize=1;arcSize=56;html=1;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="360" height="300" as="geometry"/></mxCell><mxCell id="c3" value="POUR ?" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontColor=#2F7F77;fontSize=17;fontFamily=Inter Tight;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DInter%2BTight%3Awght%40700;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="68" y="70" width="304" height="26" as="geometry"/></mxCell><mxCell id="c4" value="Les personnes dys, du primaire à l'emploi, et les parents qui les accompagnent." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontColor=#3E3A63;fontSize=18;fontFamily=Lexend;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DLexend%3Awght%40400%3B600;" vertex="1" parent="1"><mxGeometry x="68" y="116" width="304" height="200" as="geometry"/></mxCell><mxCell id="c5" value="" style="rounded=1;absoluteArcSize=1;arcSize=56;html=1;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="432" y="40" width="360" height="300" as="geometry"/></mxCell><mxCell id="c6" value="QUI ?" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontColor=#2F7F77;fontSize=17;fontFamily=Inter Tight;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DInter%2BTight%3Awght%40700;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460" y="70" width="304" height="26" as="geometry"/></mxCell><mxCell id="c7" value="S'épuisent dans des démarches sans mode d'emploi (PAP, PPS, MDPH, RQTH), doivent tout recommencer après le bac et peinent à dire leurs besoins." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontColor=#3E3A63;fontSize=18;fontFamily=Lexend;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DLexend%3Awght%40400%3B600;" vertex="1" parent="1"><mxGeometry x="460" y="116" width="304" height="200" as="geometry"/></mxCell><mxCell id="c8" value="" style="rounded=1;absoluteArcSize=1;arcSize=56;html=1;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="824" y="40" width="360" height="300" as="geometry"/></mxCell><mxCell id="c9" value="NOTRE PRODUIT" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontColor=#2F7F77;fontSize=17;fontFamily=Inter Tight;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DInter%2BTight%3Awght%40700;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="852" y="70" width="304" height="26" as="geometry"/></mxCell><mxCell id="c10" value="Est un compagnon numérique, sur mobile et sur ordinateur, pensé pour les personnes dys." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontColor=#3E3A63;fontSize=18;fontFamily=Lexend;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DLexend%3Awght%40400%3B600;" vertex="1" parent="1"><mxGeometry x="852" y="116" width="304" height="200" as="geometry"/></mxCell><mxCell id="c11" value="" style="rounded=1;absoluteArcSize=1;arcSize=56;html=1;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="372" width="360" height="300" as="geometry"/></mxCell><mxCell id="c12" value="QUI PERMET ?" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontColor=#2F7F77;fontSize=17;fontFamily=Inter Tight;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DInter%2BTight%3Awght%40700;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="68" y="402" width="304" height="26" as="geometry"/></mxCell><mxCell id="c13" value="De mener chaque démarche étape par étape, de ranger ses papiers au même endroit, de montrer ses besoins sans diagnostic et de se faire aider par Lio pour lire et écrire." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontColor=#3E3A63;fontSize=18;fontFamily=Lexend;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DLexend%3Awght%40400%3B600;" vertex="1" parent="1"><mxGeometry x="68" y="448" width="304" height="200" as="geometry"/></mxCell><mxCell id="c14" value="" style="rounded=1;absoluteArcSize=1;arcSize=56;html=1;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="432" y="372" width="360" height="300" as="geometry"/></mxCell><mxCell id="c15" value="CONTRAIREMENT" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontColor=#2F7F77;fontSize=17;fontFamily=Inter Tight;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DInter%2BTight%3Awght%40700;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460" y="402" width="304" height="26" as="geometry"/></mxCell><mxCell id="c16" value="Aux outils scolaires qui s'arrêtent au bac et aux aides éparpillées entre associations, sites et applications." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontColor=#3E3A63;fontSize=18;fontFamily=Lexend;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DLexend%3Awght%40400%3B600;" vertex="1" parent="1"><mxGeometry x="460" y="448" width="304" height="200" as="geometry"/></mxCell><mxCell id="c17" value="" style="rounded=1;absoluteArcSize=1;arcSize=56;html=1;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="824" y="372" width="360" height="300" as="geometry"/></mxCell><mxCell id="c18" value="NOUS" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontColor=#2F7F77;fontSize=17;fontFamily=Inter Tight;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DInter%2BTight%3Awght%40700;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="852" y="402" width="304" height="26" as="geometry"/></mxCell><mxCell id="c19" value="Proposons un seul compagnon qui suit la personne, pas l'établissement, du primaire jusqu'au travail, et embarque le parent quand il y en a un." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontColor=#3E3A63;fontSize=18;fontFamily=Lexend;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DLexend%3Awght%40400%3B600;" vertex="1" parent="1"><mxGeometry x="852" y="448" width="304" height="200" as="geometry"/></mxCell><mxCell id="c20" value="" style="rounded=1;absoluteArcSize=1;arcSize=56;html=1;fillColor=#34475F;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="704" width="1144" height="230" as="geometry"/></mxCell><mxCell id="c21" value="LE PITCH" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontColor=#97D4D0;fontSize=17;fontFamily=Inter Tight;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DInter%2BTight%3Awght%40700;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="76" y="734" width="400" height="26" as="geometry"/></mxCell><mxCell id="c22" value="« Pour les personnes dys, du primaire à l'emploi, et les parents qui les accompagnent, qui s'épuisent dans des démarches sans mode d'emploi, &lt;b&gt;Pass'Dys&lt;/b&gt; est un compagnon numérique qui permet de mener chaque démarche étape par étape, de ranger ses papiers et de montrer ses besoins sans diagnostic. Contrairement aux outils scolaires qui s'arrêtent au bac, nous proposons un seul compagnon qui &lt;b&gt;suit la personne, du primaire jusqu'au travail&lt;/b&gt;. »" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontColor=#FFFFFF;fontSize=19;fontFamily=Lexend;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DLexend%3Awght%40400%3B600;" vertex="1" parent="1"><mxGeometry x="76" y="774" width="1072" height="140" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>