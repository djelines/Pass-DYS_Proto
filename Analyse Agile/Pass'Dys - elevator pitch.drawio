Lexend;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DLexend%3Awght%40400%3B600;fontFamily=Inter Tight;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DInter%2BTight%3Awght%40700;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="908" y="292" width="300" height="26" as="geometry"/></mxCell><mxCell id="c32" value="Suit la personne, pas l'établissement, à chaque étape de sa vie" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontColor=#3E3A63;fontSize=16;fontFamily=Lexend;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DLexend%3Awght%40400%3B600;" vertex="1" parent="1"><mxGeometry x="872" y="332" width="332" height="76" as="geometry"/></mxCell><mxCell id="c33" value="" style="shape=line;direction=south;html=1;strokeColor=#34475F;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="633.0" y="430" width="2" height="22" as="geometry"/></mxCell><mxCell id="c34" value="" style="rounded=1;arcSize=8;html=1;fillColor=#34475F;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="456" width="1188" height="190" as="geometry"/></mxCell><mxCell id="c35" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="72" y="488" width="64" height="64" as="geometry"/></mxCell><mxCell id="c36" value="« Pour les personnes dys et leurs parents, qui s'épuisent dans des démarches sans mode d'emploi, &lt;b&gt;Pass'Dys&lt;/b&gt; est un compagnon numérique qui permet de mener chaque démarche étape par étape, de ranger ses papiers et de dire ses besoins sans diagnostic. Contrairement aux outils qui s'arrêtent au bac, &lt;b&gt;Pass'Dys suit la personne, du primaire au travail.&lt;/b&gt; »" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#FFFFFF;fontSize=19;fontFamily=Lexend;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DLexend%3Awght%40400%3B600;" ver